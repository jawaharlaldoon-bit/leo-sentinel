# Safe defaults: the complete public demo works without IBM credentials.
DEMO_MODE=true
PORT=7860
NEXT_PUBLIC_HF_SPACE=true

# Live watsonx inference is opt-in. Leave false until a watsonx.ai Runtime Lite
# project and its free allowance have been verified. Never commit real values.
WATSONX_LIVE_ENABLED=false
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_CHAT_MODEL=ibm/granite-4-h-small
WATSONX_TTM_MODEL=ibm/granite-ttm-512-96-r2

# Forecast refresh is blocked in production unless this private token is sent
# in x-forecast-refresh-token. Public users receive the cache/fallback.
WATSONX_FORECAST_REFRESH_TOKEN=
AI_RATE_LIMIT_PER_MINUTE=8
